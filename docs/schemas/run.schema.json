{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vgxness.dev/schemas/run.schema.json",
  "title": "VGXNESS Run Snapshot",
  "description": "Full run snapshot for a user-requested VGXNESS workflow, including phases, artifacts, memory writes, decisions, and validations.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "project",
    "goal",
    "status",
    "storageMode",
    "artifactBackend",
    "orchestratorSelection",
    "routingDecision",
    "sddPreflight",
    "createdAt",
    "updatedAt",
    "phases",
    "artifacts",
    "memoryWrites",
    "decisions",
    "tasks",
    "cancellations",
    "results",
    "capsules",
    "validations"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable run identifier."
    },
    "project": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable project identifier."
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "description": "User-facing goal for the run."
    },
    "status": {
      "$ref": "#/$defs/runStatus"
    },
    "storageMode": {
      "$ref": "#/$defs/storageMode"
    },
    "artifactBackend": {
      "$ref": "#/$defs/artifactBackend"
    },
    "orchestratorSelection": {
      "$ref": "orchestration.schema.json#/$defs/providerSelection"
    },
    "routingDecision": {
      "$ref": "orchestration.schema.json#/$defs/routingDecision"
    },
    "sddPreflight": {
      "$ref": "orchestration.schema.json#/$defs/sddPreflight"
    },
    "createdAt": {
      "$ref": "#/$defs/timestamp"
    },
    "updatedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "resumeFrom": {
      "$ref": "#/$defs/resumeFrom"
    },
    "phases": {
      "type": "array",
      "description": "Ordered phase snapshots for this run.",
      "items": {
        "$ref": "#/$defs/phase"
      }
    },
    "artifacts": {
      "type": "array",
      "description": "Artifacts produced or accepted during the run.",
      "items": {
        "$ref": "common.schema.json#/$defs/artifactReferenceInput"
      }
    },
    "memoryWrites": {
      "type": "array",
      "description": "Semantic memory writes associated with the run.",
      "items": {
        "$ref": "#/$defs/memoryWrite"
      }
    },
    "decisions": {
      "type": "array",
      "description": "Important decisions made during the run.",
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "tasks": {
      "type": "array",
      "items": { "$ref": "#/$defs/task" }
    },
    "cancellations": {
      "type": "array",
      "items": { "$ref": "execution.schema.json#/$defs/cancellation" }
    },
    "results": {
      "type": "array",
      "items": { "$ref": "execution.schema.json#/$defs/agentResult" }
    },
    "capsules": {
      "type": "array",
      "items": { "$ref": "execution.schema.json#/$defs/continuityCapsule" }
    },
    "validations": {
      "type": "array",
      "description": "Validation and review results associated with the run.",
      "items": {
        "$ref": "#/$defs/validation"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "storageMode": {
      "type": "string",
      "enum": ["project-local", "user-global"]
    },
    "artifactBackend": {
      "type": "string",
      "enum": ["filesystem", "memory", "hybrid", "none"]
    },
    "runStatus": {
      "type": "string",
      "enum": ["created", "running", "paused", "blocked", "recovering", "completed", "failed", "cancelled"]
    },
    "phaseStatus": {
      "type": "string",
      "enum": ["pending", "running", "blocked", "completed", "failed", "skipped", "cancelled"]
    },
    "validationStatus": {
      "type": "string",
      "enum": ["pending", "passed", "failed", "blocked", "skipped"]
    },
    "phase": {
      "type": "object",
      "required": ["name", "status", "artifacts", "memoryWrites", "validations"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/phaseStatus"
        },
        "startedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "completedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "failedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "memoryWrites": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "validations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "required": ["taskId", "phase", "agentId", "status", "contextPacketId"],
      "properties": {
        "taskId": { "type": "string", "minLength": 1 },
        "phase": { "type": "string", "minLength": 1 },
        "agentId": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/phaseStatus" },
        "contextPacketId": { "type": "string", "minLength": 1 },
        "loopId": { "type": "string", "minLength": 1 },
        "resultId": { "type": "string", "minLength": 1 },
        "cancellationId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["id", "kind", "path", "backend", "writtenAt"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "description": "Artifact kind, such as proposal, spec, design, tasks, verify-report, or registry."
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "backend": {
          "$ref": "#/$defs/artifactBackend"
        },
        "phase": {
          "type": "string",
          "minLength": 1
        },
        "writtenAt": {
          "$ref": "#/$defs/timestamp"
        },
        "checksum": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "memoryWrite": {
      "type": "object",
      "required": ["id", "backend", "provenance", "at"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "backend": {
          "type": "string",
          "const": "memory"
        },
        "topicKey": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "$ref": "common.schema.json#/$defs/provenance"
        },
        "at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": ["decisionId", "summary", "at"],
      "properties": {
        "decisionId": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string"
        },
        "phase": {
          "type": "string",
          "minLength": 1
        },
        "by": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "required": ["id", "type", "status", "at"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "description": "Validation kind, such as tests, schema, review, doctor, or readback."
        },
        "status": {
          "$ref": "#/$defs/validationStatus"
        },
        "phase": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "resumeFrom": {
      "type": "object",
      "required": ["runId", "checkpointId"],
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "checkpointId": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}

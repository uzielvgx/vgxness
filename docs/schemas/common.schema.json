{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vgxness.dev/schemas/common.schema.json",
  "title": "VGXNESS Common Contracts",
  "description": "Provider-neutral identifiers, references, provenance, language policy, and contract failures.",
  "oneOf": [
    { "$ref": "#/$defs/artifactProvider" },
    { "$ref": "#/$defs/artifactReference" },
    { "$ref": "#/$defs/languagePolicy" },
    { "$ref": "#/$defs/contractError" }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "schemaVersion": { "const": "1" },
    "timestamp": { "type": "string", "format": "date-time" },
    "checksum": {
      "type": "object",
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "type": "string", "enum": ["sha256", "sha512"] },
        "value": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "providerReference": {
      "type": "object",
      "required": ["provider", "id"],
      "properties": {
        "provider": { "$ref": "#/$defs/identifier" },
        "id": { "$ref": "#/$defs/identifier" },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "sourceReference": {
      "type": "object",
      "required": ["provider", "id"],
      "properties": {
        "provider": { "$ref": "#/$defs/identifier" },
        "id": { "$ref": "#/$defs/identifier" },
        "uri": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["producer", "createdAt"],
      "properties": {
        "producer": { "$ref": "#/$defs/identifier" },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "runId": { "$ref": "#/$defs/identifier" },
        "phase": { "$ref": "#/$defs/identifier" },
        "agentId": { "$ref": "#/$defs/identifier" },
        "source": { "$ref": "#/$defs/sourceReference" },
        "checksum": { "$ref": "#/$defs/checksum" }
      },
      "additionalProperties": false
    },
    "skillSource": {
      "type": "object",
      "required": ["scope", "provider", "id"],
      "properties": {
        "scope": { "type": "string", "enum": ["user", "project", "runtime", "shared"] },
        "provider": { "$ref": "#/$defs/identifier" },
        "id": { "$ref": "#/$defs/identifier" },
        "uri": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "skillProvenance": {
      "type": "object",
      "required": ["registryId", "registryVersion", "generatedAt", "entryRef"],
      "properties": {
        "registryId": { "$ref": "#/$defs/identifier" },
        "registryVersion": { "type": "string", "minLength": 1 },
        "generatedAt": { "$ref": "#/$defs/timestamp" },
        "entryRef": { "$ref": "#/$defs/sourceReference" },
        "checksum": { "$ref": "#/$defs/checksum" }
      },
      "additionalProperties": false
    },
    "artifactProvider": {
      "type": "object",
      "required": ["kind", "schemaVersion", "id", "type", "capabilities"],
      "properties": {
        "kind": { "const": "artifact.provider" },
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "$ref": "#/$defs/identifier" },
        "version": { "type": "string", "minLength": 1 },
        "capabilities": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "artifactReference": {
      "type": "object",
      "required": ["kind", "schemaVersion", "provider", "id", "artifactType", "provenance"],
      "properties": {
        "kind": { "const": "artifact.reference" },
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "provider": { "$ref": "#/$defs/identifier" },
        "id": { "$ref": "#/$defs/identifier" },
        "artifactType": { "$ref": "#/$defs/identifier" },
        "uri": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "checksum": { "$ref": "#/$defs/checksum" },
        "provenance": { "$ref": "#/$defs/provenance" }
      },
      "additionalProperties": false
    },
    "legacyArtifactReference": {
      "description": "Deprecated reader-only artifact forms. Writers emit artifactReference.",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["id", "kind", "path", "backend", "writtenAt"],
          "properties": {
            "id": { "$ref": "#/$defs/identifier" },
            "kind": { "$ref": "#/$defs/identifier" },
            "path": { "type": "string", "minLength": 1 },
            "backend": { "$ref": "#/$defs/identifier" },
            "writtenAt": { "$ref": "#/$defs/timestamp" },
            "checksum": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      ]
    },
    "artifactReferenceInput": {
      "oneOf": [
        { "$ref": "#/$defs/artifactReference" },
        { "$ref": "#/$defs/legacyArtifactReference" }
      ]
    },
    "languagePolicy": {
      "type": "object",
      "required": ["kind", "schemaVersion", "userFacing", "technicalArtifacts", "subagentInstructions"],
      "properties": {
        "kind": { "const": "language.policy" },
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "userFacing": { "type": "string", "enum": ["match-user", "explicit"] },
        "technicalArtifacts": { "type": "string", "enum": ["english", "explicit", "project-policy"] },
        "subagentInstructions": { "type": "string", "enum": ["english", "explicit", "project-policy"] },
        "explicitLanguage": { "type": "string", "minLength": 2 },
        "overrideBy": { "$ref": "#/$defs/identifier" },
        "overrideReason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "contractError": {
      "type": "object",
      "required": ["kind", "schemaVersion", "code", "schemaUri", "pointer", "message", "recoverable"],
      "properties": {
        "kind": { "const": "contract.invalid" },
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "code": { "const": "contract.invalid" },
        "schemaUri": { "type": "string", "minLength": 1 },
        "pointer": { "type": "string" },
        "message": { "type": "string", "minLength": 1 },
        "recoverable": { "type": "boolean" },
        "details": { "type": "object" }
      },
      "additionalProperties": false
    }
  }
}

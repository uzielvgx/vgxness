{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vgxness.dev/schemas/current-run.schema.json",
  "title": "VGXNESS Current Run",
  "description": "Active run pointer and lightweight snapshot for recovery, status, and operator inspection.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "project",
    "goal",
    "status",
    "phase",
    "selectionId",
    "decisionId",
    "preflightId",
    "taskId",
    "lastEventId",
    "artifactIds",
    "storageMode",
    "startedAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable run identifier."
    },
    "project": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable project identifier."
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "description": "User-facing goal for the active run."
    },
    "status": {
      "type": "string",
      "enum": ["running", "paused", "blocked", "recovering"],
      "description": "Current active-run status. Terminal runs should be removed from current-run.json after finalization."
    },
    "phase": {
      "type": "string",
      "minLength": 1,
      "description": "Current phase name, such as explore, propose, spec, design, plan, apply, verify, or archive."
    },
    "selectionId": {
      "type": "string",
      "minLength": 1
    },
    "decisionId": {
      "type": "string",
      "minLength": 1
    },
    "preflightId": {
      "type": "string",
      "minLength": 1
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "cancellationId": {
      "type": "string",
      "minLength": 1
    },
    "resultId": {
      "type": "string",
      "minLength": 1
    },
    "capsuleId": {
      "type": "string",
      "minLength": 1
    },
    "lastEventId": {
      "type": "string",
      "minLength": 1
    },
    "artifactIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "storageMode": {
      "type": "string",
      "enum": ["project-local", "user-global"],
      "description": "Where VGXNESS stores this run's operational files."
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the run started."
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the pointer was last updated."
    },
    "runFile": {
      "type": "string",
      "minLength": 1,
      "description": "Optional path to the full run snapshot, relative to the VGXNESS storage root."
    },
    "logFile": {
      "type": "string",
      "minLength": 1,
      "description": "Optional path to the JSONL event log, relative to the VGXNESS storage root."
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vgxness.dev/schemas/delivery-receipt.schema.json",
  "title": "VGXNESS Content-bound Review Receipt",
  "type": "object",
  "required": ["kind", "schemaVersion", "receiptId", "issuedAt", "target", "bindings", "manifest"],
  "properties": {
    "kind": { "const": "delivery.review-receipt" },
    "schemaVersion": { "const": "1" },
    "receiptId": { "$ref": "#/$defs/sha256" },
    "issuedAt": { "type": "string", "format": "date-time" },
    "target": {
      "type": "object",
      "required": ["baseRevision", "baseTree", "candidateTree", "paths", "pathsSha256"],
      "properties": {
        "baseRevision": { "$ref": "#/$defs/objectId" },
        "baseTree": { "$ref": "#/$defs/objectId" },
        "candidateTree": { "$ref": "#/$defs/objectId" },
        "paths": { "type": "array", "maxItems": 10000, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 4096 } },
        "pathsSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "bindings": {
      "type": "object",
      "required": ["contextSha256", "evidenceSha256", "reviewSha256"],
      "properties": {
        "contextSha256": { "$ref": "#/$defs/sha256" },
        "evidenceSha256": { "$ref": "#/$defs/sha256" },
        "reviewSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "manifest": { "$ref": "delivery-manifest.schema.json" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "objectId": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vgxness.dev/schemas/agents.schema.json",
  "title": "VGXNESS Agents Registry",
  "description": "Generated registry of manager, executor, and review agents available to a VGXNESS runtime projection.",
  "type": "object",
  "required": ["schemaVersion", "version", "generatedAt", "agents"],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "description": "Registry format or generation version."
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the registry was generated."
    },
    "agents": {
      "type": "array",
      "description": "Generated agent entries.",
      "items": {
        "$ref": "#/$defs/agent"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "agent": {
      "type": "object",
      "required": [
        "id",
        "name",
        "role",
        "mode",
        "schemaVersion",
        "provider",
        "hidden",
        "capabilities",
        "skillRefs",
        "permissions",
        "executionPolicy",
        "provenance"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "common.schema.json#/$defs/schemaVersion"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable agent identifier used by run events and delegation."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable agent name."
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "description": "Primary responsibility, such as manager, explore, design, apply, verify, archive, or review-risk."
        },
        "mode": {
          "type": "string",
          "enum": ["manager", "executor", "reviewer", "utility"],
          "description": "How the runtime should treat this agent."
        },
        "provider": {
          "$ref": "common.schema.json#/$defs/providerReference",
          "description": "Negotiated runtime/provider adapter identity."
        },
        "hidden": {
          "type": "boolean",
          "description": "Whether this agent should be hidden from direct user selection in runtimes that support hidden agents."
        },
        "capabilities": {
          "type": "array",
          "description": "Capability labels advertised by this agent.",
          "items": {
            "$ref": "orchestration.schema.json#/$defs/capabilityDeclaration"
          },
          "uniqueItems": true
        },
        "skillRefs": {
          "type": "array",
          "description": "Exact, versioned skill identities resolved from a registry.",
          "items": {
            "$ref": "execution.schema.json#/$defs/exactSkillReference"
          },
          "uniqueItems": true
        },
        "permissions": {
          "$ref": "#/$defs/permissions"
        },
        "executionPolicy": {
          "$ref": "execution.schema.json#/$defs/executionPolicy"
        },
        "provenance": {
          "$ref": "common.schema.json#/$defs/provenance"
        },
        "promptRef": {
          "type": "string",
          "minLength": 1,
          "description": "Optional prompt template path or reference."
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "description": "Optional default model identifier."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "enum": ["executor", "reviewer", "utility"] } }, "required": ["mode"] },
          "then": {
            "properties": {
              "executionPolicy": {
                "properties": { "mayDelegate": { "const": false } }
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "permissions": {
      "type": "object",
      "required": [
        "mayReadFiles",
        "mayWriteFiles",
        "mayRunCommands",
        "mayInstallPackages",
        "mayCommit",
        "mayPush",
        "mayUseNetwork",
        "mayUseMcp"
      ],
      "properties": {
        "mayReadFiles": {
          "type": "boolean"
        },
        "mayWriteFiles": {
          "type": "boolean"
        },
        "mayRunCommands": {
          "type": "boolean"
        },
        "mayInstallPackages": {
          "type": "boolean"
        },
        "mayCommit": {
          "type": "boolean"
        },
        "mayPush": {
          "type": "boolean"
        },
        "mayUseNetwork": {
          "type": "boolean"
        },
        "mayUseMcp": {
          "type": "boolean"
        },
        "allowedTools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "deniedTools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "allowedPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "deniedPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vgxness.dev/schemas/delivery-manifest.schema.json",
  "title": "VGXNESS Delivery Manifest",
  "type": "object",
  "required": ["schemaVersion", "context", "evidence", "review"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "context": {
      "type": "object",
      "required": ["policy", "prompt", "registry", "provider", "model"],
      "properties": {
        "policy": { "$ref": "#/$defs/identity" },
        "prompt": { "$ref": "#/$defs/identity" },
        "registry": { "$ref": "#/$defs/identity" },
        "provider": { "$ref": "#/$defs/identity" },
        "model": { "$ref": "#/$defs/identity" }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["checks"],
      "properties": {
        "checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/check" }
        }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": ["risk", "lenses", "verdict", "findings", "rollbackBoundary"],
      "properties": {
        "risk": { "enum": ["low", "medium", "high"] },
        "lenses": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["review-readability", "review-reliability", "review-resilience", "review-risk"] }
        },
        "verdict": { "enum": ["approved", "rejected"] },
        "findings": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "required": ["severity", "code", "summary"],
            "properties": {
              "severity": { "enum": ["info", "warning", "major", "critical", "blocker"] },
              "code": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$" },
              "summary": { "type": "string", "minLength": 1, "maxLength": 1024 }
            },
            "additionalProperties": false
          }
        },
        "rollbackBoundary": { "type": "string", "minLength": 1, "maxLength": 1024 }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "identity": {
      "type": "object",
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._/@+-]+$" },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "required": ["id", "command", "exitCode", "outputSha256", "startedAt", "finishedAt", "toolchain"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$" },
        "command": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "exitCode": { "type": "integer", "minimum": 0, "maximum": 255 },
        "outputSha256": { "$ref": "#/$defs/sha256" },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" },
        "toolchain": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/identity" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

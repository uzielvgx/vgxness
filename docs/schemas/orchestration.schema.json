{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vgxness.dev/schemas/orchestration.schema.json",
  "title": "VGXNESS Orchestration Contracts",
  "description": "Capability negotiation, provider selection, routing, selective SDD, and structured questions.",
  "oneOf": [
    { "$ref": "#/$defs/providerSelection" },
    { "$ref": "#/$defs/routingDecision" },
    { "$ref": "#/$defs/delegationRequest" },
    { "$ref": "#/$defs/delegationPlan" },
    { "$ref": "#/$defs/delegationJoin" },
    { "$ref": "#/$defs/sddPreflight" },
    { "$ref": "#/$defs/structuredQuestion" },
    { "$ref": "#/$defs/structuredAnswer" }
  ],
  "$defs": {
    "delegationTask": {
      "type": "object",
      "required": ["taskId", "capability", "operation", "goal", "acceptanceCriteria", "dependsOn", "continuity"],
      "properties": {
        "taskId": { "$ref": "common.schema.json#/$defs/identifier" },
        "capability": { "type": "string", "enum": ["explore", "verify", "review", "implement"] },
        "operation": { "type": "string", "enum": ["read-files", "analyze-structure", "review-changes", "write-files"] },
        "goal": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "acceptanceCriteria": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
        },
        "dependsOn": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "common.schema.json#/$defs/identifier" },
          "uniqueItems": true
        },
        "continuity": { "type": "string", "enum": ["isolated", "linked"] }
      },
      "additionalProperties": false
    },
    "delegationRequest": {
      "type": "object",
      "required": ["kind", "schemaVersion", "goal", "acceptanceCriteria", "candidateTasks", "policyVersion", "maxParallel"],
      "properties": {
        "kind": { "const": "delegation.request" },
        "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
        "goal": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "acceptanceCriteria": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
        },
        "candidateTasks": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/delegationTask" }
        },
        "policyVersion": { "type": "string", "minLength": 1, "maxLength": 240 },
        "maxParallel": { "type": "integer", "minimum": 1, "maximum": 4 }
      },
      "additionalProperties": false
    },
    "executionWave": {
      "type": "object",
      "required": ["waveId", "index", "mode", "taskIds"],
      "properties": {
        "waveId": { "$ref": "common.schema.json#/$defs/identifier" },
        "index": { "type": "integer", "minimum": 0, "maximum": 15 },
        "mode": { "type": "string", "enum": ["sequential", "parallel"] },
        "taskIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "$ref": "common.schema.json#/$defs/identifier" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "delegationPlan": {
      "type": "object",
      "required": ["kind", "schemaVersion", "planId", "requestDigest", "decision", "rationale", "policyVersion", "maxParallel", "tasks", "waves"],
      "properties": {
        "kind": { "const": "delegation.plan" },
        "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
        "planId": { "type": "string", "pattern": "^plan-[a-f0-9]{64}$" },
        "requestDigest": { "type": "string", "pattern": "^sha256-[a-f0-9]{64}$" },
        "decision": { "type": "string", "enum": ["single", "sequential", "parallel"] },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "policyVersion": { "type": "string", "minLength": 1, "maxLength": 240 },
        "maxParallel": { "type": "integer", "minimum": 1, "maximum": 4 },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/delegationTask" }
        },
        "waves": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/executionWave" }
        }
      },
      "additionalProperties": false
    },
    "joinedTask": {
      "type": "object",
      "required": ["taskId", "status", "dispatchStatus", "parentSessionId", "childSessionId", "ticketId"],
      "properties": {
        "taskId": { "$ref": "common.schema.json#/$defs/identifier" },
        "status": { "type": "string", "enum": ["completed", "failed", "cancelled"] },
        "dispatchStatus": { "type": "string", "enum": ["confirmed", "not_started", "uncertain"] },
        "parentSessionId": { "$ref": "common.schema.json#/$defs/identifier" },
        "childSessionId": { "$ref": "common.schema.json#/$defs/identifier" },
        "ticketId": { "$ref": "common.schema.json#/$defs/identifier" },
        "messageId": { "$ref": "common.schema.json#/$defs/identifier" },
        "resultId": { "$ref": "common.schema.json#/$defs/identifier" },
        "resultDigest": { "type": "string", "pattern": "^sha256-[a-f0-9]{64}$" },
        "failure": { "type": "string", "minLength": 1, "maxLength": 2048 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "completed" } }, "required": ["status"] },
          "then": { "required": ["messageId", "resultId", "resultDigest"], "not": { "required": ["failure"] } },
          "else": { "required": ["failure"], "not": { "anyOf": [{ "required": ["messageId"] }, { "required": ["resultId"] }, { "required": ["resultDigest"] }] } }
        }
      ],
      "additionalProperties": false
    },
    "delegationJoin": {
      "type": "object",
      "required": ["kind", "schemaVersion", "planId", "status", "completed", "failed", "cancelled", "tasks"],
      "properties": {
        "kind": { "const": "delegation.join" },
        "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
        "planId": { "$ref": "common.schema.json#/$defs/identifier" },
        "status": { "type": "string", "enum": ["completed", "partial", "failed", "cancelled"] },
        "completed": { "type": "integer", "minimum": 0, "maximum": 16 },
        "failed": { "type": "integer", "minimum": 0, "maximum": 16 },
        "cancelled": { "type": "integer", "minimum": 0, "maximum": 16 },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/joinedTask" }
        }
      },
      "additionalProperties": false
    },
    "capabilityNeed": {
      "type": "object",
      "required": ["capability", "version"],
      "properties": {
        "capability": { "$ref": "common.schema.json#/$defs/identifier" },
        "version": { "type": "string", "minLength": 1 },
        "constraints": { "type": "object" }
      },
      "additionalProperties": false
    },
    "capabilityDeclaration": {
      "type": "object",
      "required": ["capability", "version"],
      "properties": {
        "capability": { "$ref": "common.schema.json#/$defs/identifier" },
        "version": { "type": "string", "minLength": 1 },
        "constraints": { "type": "object" }
      },
      "additionalProperties": false
    },
    "candidateCapabilityEvidence": {
      "type": "object",
      "required": ["capability", "version", "constraints"],
      "properties": {
        "capability": { "$ref": "common.schema.json#/$defs/identifier" },
        "version": { "type": "string", "minLength": 1 },
        "constraints": { "type": "object" }
      },
      "additionalProperties": false
    },
    "providerCandidate": {
      "type": "object",
      "required": ["provider", "capabilities", "eligible", "reasons"],
      "properties": {
        "provider": { "$ref": "common.schema.json#/$defs/identifier" },
        "capabilities": {
          "type": "array",
          "items": { "$ref": "#/$defs/candidateCapabilityEvidence" },
          "uniqueItems": true
        },
        "eligible": { "type": "boolean" },
        "reasons": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/identifier" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "providerSelection": {
      "type": "object",
      "required": ["kind", "schemaVersion", "selectionId", "needs", "candidates", "status", "policyVersion", "rationale", "decidedAt"],
      "properties": {
        "kind": { "const": "orchestrator.selection" },
        "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
        "selectionId": { "$ref": "common.schema.json#/$defs/identifier" },
        "needs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/capabilityNeed" } },
        "candidates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/providerCandidate" } },
        "status": { "type": "string", "enum": ["selected", "unsupported"] },
        "selectedProvider": { "$ref": "common.schema.json#/$defs/identifier" },
        "policyVersion": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "decidedAt": { "$ref": "common.schema.json#/$defs/timestamp" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "selected" } }, "required": ["status"] },
          "then": { "required": ["selectedProvider"] },
          "else": { "not": { "required": ["selectedProvider"] } }
        }
      ],
      "additionalProperties": false
    },
    "routingDecision": {
      "type": "object",
      "required": ["kind", "schemaVersion", "decisionId", "inputRefs", "difficulty", "risk", "candidates", "selectedAgent", "route", "rationale", "policyVersion", "sdd", "decidedAt"],
      "properties": {
        "kind": { "const": "routing.decision" },
        "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
        "decisionId": { "$ref": "common.schema.json#/$defs/identifier" },
        "inputRefs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/artifactReference" } },
        "difficulty": { "type": "string", "enum": ["low", "medium", "high"] },
        "risk": { "type": "string", "enum": ["low", "medium", "high"] },
        "candidates": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/identifier" }, "uniqueItems": true },
        "selectedAgent": { "$ref": "common.schema.json#/$defs/identifier" },
        "route": { "$ref": "common.schema.json#/$defs/identifier" },
        "rationale": { "type": "string", "minLength": 1 },
        "policyVersion": { "type": "string", "minLength": 1 },
        "sdd": { "type": "string", "enum": ["required", "skipped", "overridden"] },
        "override": {
          "type": "object",
          "required": ["by", "reason"],
          "properties": {
            "by": { "$ref": "common.schema.json#/$defs/identifier" },
            "reason": { "type": "string", "minLength": 1 },
            "approved": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "decidedAt": { "$ref": "common.schema.json#/$defs/timestamp" }
      },
      "allOf": [
        {
          "if": { "properties": { "sdd": { "const": "overridden" } }, "required": ["sdd"] },
          "then": { "required": ["override"] },
          "else": { "not": { "required": ["override"] } }
        }
      ],
      "additionalProperties": false
    },
    "sddPreflight": {
      "type": "object",
      "required": ["kind", "schemaVersion", "preflightId", "mode", "backend", "status", "artifactAccess", "checkedAt"],
      "properties": {
        "kind": { "const": "sdd.preflight" },
        "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
        "preflightId": { "$ref": "common.schema.json#/$defs/identifier" },
        "mode": { "type": "string", "enum": ["auto", "required", "off"] },
        "backend": { "type": "string", "enum": ["memory", "openspec", "hybrid", "none"] },
        "status": { "type": "string", "enum": ["ready", "fallback", "blocked", "not-run"] },
        "artifactAccess": { "type": "boolean" },
        "fallbackDecision": { "type": "string", "minLength": 1 },
        "error": { "$ref": "common.schema.json#/$defs/contractError" },
        "checkedAt": { "$ref": "common.schema.json#/$defs/timestamp" }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "off" } }, "required": ["mode"] },
          "then": {
            "properties": {
              "backend": { "const": "none" },
              "status": { "const": "not-run" },
              "artifactAccess": { "const": false }
            },
            "not": {
              "anyOf": [
                { "required": ["fallbackDecision"] },
                { "required": ["error"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "mode": { "const": "required" } }, "required": ["mode"] },
          "then": {
            "properties": {
              "backend": { "type": "string", "enum": ["memory", "openspec", "hybrid"] },
              "status": { "type": "string", "enum": ["ready", "blocked"] }
            },
            "not": { "required": ["fallbackDecision"] },
            "allOf": [
              {
                "if": { "properties": { "status": { "const": "ready" } }, "required": ["status"] },
                "then": {
                  "properties": { "artifactAccess": { "const": true } },
                  "not": { "required": ["error"] }
                }
              },
              {
                "if": { "properties": { "status": { "const": "blocked" } }, "required": ["status"] },
                "then": { "required": ["error"] }
              }
            ]
          }
        },
        {
          "if": { "properties": { "mode": { "const": "auto" } }, "required": ["mode"] },
          "then": {
            "properties": {
              "status": { "type": "string", "enum": ["ready", "fallback", "not-run"] }
            },
            "allOf": [
              {
                "if": { "properties": { "status": { "const": "ready" } }, "required": ["status"] },
                "then": {
                  "properties": {
                    "backend": { "type": "string", "enum": ["memory", "openspec", "hybrid"] },
                    "artifactAccess": { "const": true }
                  },
                  "not": {
                    "anyOf": [
                      { "required": ["fallbackDecision"] },
                      { "required": ["error"] }
                    ]
                  }
                }
              },
              {
                "if": { "properties": { "status": { "const": "fallback" } }, "required": ["status"] },
                "then": { "required": ["fallbackDecision", "error"] }
              },
              {
                "if": { "properties": { "status": { "const": "not-run" } }, "required": ["status"] },
                "then": {
                  "properties": {
                    "backend": { "const": "none" },
                    "artifactAccess": { "const": false }
                  },
                  "not": {
                    "anyOf": [
                      { "required": ["fallbackDecision"] },
                      { "required": ["error"] }
                    ]
                  }
                }
              }
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "structuredQuestion": {
      "type": "object",
      "required": ["kind", "schemaVersion", "questionId", "prompt", "answerShape", "blocking"],
      "properties": {
        "kind": { "const": "structured.question" },
        "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
        "questionId": { "$ref": "common.schema.json#/$defs/identifier" },
        "prompt": { "type": "string", "minLength": 1 },
        "answerShape": { "type": "string", "enum": ["text", "boolean", "choice", "multi-choice", "integer", "json"] },
        "blocking": { "type": "boolean" },
        "choices": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      },
      "allOf": [
        {
          "if": { "properties": { "answerShape": { "enum": ["choice", "multi-choice"] } }, "required": ["answerShape"] },
          "then": { "required": ["choices"] },
          "else": { "not": { "required": ["choices"] } }
        }
      ],
      "additionalProperties": false
    },
    "structuredAnswer": {
      "type": "object",
      "required": ["kind", "schemaVersion", "questionId", "answerShape", "value", "answeredAt"],
      "properties": {
        "kind": { "const": "structured.answer" },
        "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
        "questionId": { "$ref": "common.schema.json#/$defs/identifier" },
        "answerShape": { "type": "string", "enum": ["text", "boolean", "choice", "multi-choice", "integer", "json"] },
        "value": {},
        "answeredAt": { "$ref": "common.schema.json#/$defs/timestamp" }
      },
      "allOf": [
        { "if": { "properties": { "answerShape": { "enum": ["text", "choice"] } } }, "then": { "properties": { "value": { "type": "string", "minLength": 1 } } } },
        { "if": { "properties": { "answerShape": { "const": "boolean" } } }, "then": { "properties": { "value": { "type": "boolean" } } } },
        { "if": { "properties": { "answerShape": { "const": "multi-choice" } } }, "then": { "properties": { "value": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true } } } },
        { "if": { "properties": { "answerShape": { "const": "integer" } } }, "then": { "properties": { "value": { "type": "integer" } } } },
        { "if": { "properties": { "answerShape": { "const": "json" } } }, "then": { "properties": { "value": { "type": "object" } } } }
      ],
      "additionalProperties": false
    }
  }
}

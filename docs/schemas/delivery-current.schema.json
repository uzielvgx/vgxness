{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vgxness.dev/schemas/delivery-current.schema.json",
  "title": "VGXNESS Current Delivery Receipt",
  "type": "object",
  "required": ["schemaVersion", "receiptId", "receiptSha256", "state", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "receiptId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "receiptSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "state": { "enum": ["active", "invalidated"] },
    "updatedAt": { "type": "string", "format": "date-time" },
    "reason": { "type": "string", "minLength": 1, "maxLength": 512 }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "invalidated" } } },
      "then": { "required": ["reason"] },
      "else": { "not": { "required": ["reason"] } }
    }
  ],
  "additionalProperties": false
}

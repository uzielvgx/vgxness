{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vgxness.dev/schemas/run-event.schema.json",
  "title": "VGXNESS Run Event",
  "description": "One append-only JSONL event object for a VGXNESS run log.",
  "type": "object",
  "required": ["schemaVersion", "eventId", "runId", "at", "type"],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "description": "Run identifier shared with the run snapshot."
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp for this event."
    },
    "type": {
      "type": "string",
      "enum": [
        "run.started",
        "run.updated",
        "run.completed",
        "run.failed",
        "phase.started",
        "phase.completed",
        "phase.failed",
        "artifact.written",
        "memory.written",
        "validation.completed",
        "checkpoint.created",
        "recovery.started",
        "recovery.completed",
        "orchestrator.selected",
        "routing.decided",
        "preflight.completed",
        "question.asked",
        "question.answered",
        "task.started",
        "task.completed",
        "task.failed",
        "background.started",
        "background.completed",
        "background.failed",
        "loop.terminated",
        "cancellation.requested",
        "cancellation.completed",
        "result.accepted",
        "capsule.written"
      ],
      "description": "Event type."
    },
    "phase": {
      "type": "string",
      "minLength": 1,
      "description": "Optional phase name associated with the event."
    },
    "agent": {
      "type": "string",
      "minLength": 1,
      "description": "Optional agent identifier associated with the event."
    },
    "selectionId": {
      "type": "string",
      "minLength": 1
    },
    "decisionId": {
      "type": "string",
      "minLength": 1
    },
    "preflightId": {
      "type": "string",
      "minLength": 1
    },
    "questionId": {
      "type": "string",
      "minLength": 1
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "cancellationId": {
      "type": "string",
      "minLength": 1
    },
    "resultId": {
      "type": "string",
      "minLength": 1
    },
    "resultDigest": {
      "$ref": "common.schema.json#/$defs/identifier",
      "description": "Content digest that binds terminal and acceptance evidence to the exact native result bytes."
    },
    "capsuleId": {
      "type": "string",
      "minLength": 1
    },
    "loopId": {
      "type": "string",
      "minLength": 1
    },
    "artifact": {
      "description": "Artifact path or structured artifact summary associated with this event.",
      "$ref": "common.schema.json#/$defs/artifactReferenceInput"
    },
    "memoryWrite": {
      "description": "Memory write identifier or structured memory write summary associated with this event.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "$ref": "#/$defs/memoryWriteRef"
        }
      ]
    },
    "validation": {
      "description": "Validation identifier or structured validation summary associated with this event.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "$ref": "#/$defs/validationRef"
        }
      ]
    },
    "failure": {
      "$ref": "#/$defs/failureEvidence"
    },
    "message": {
      "type": "string",
      "description": "Optional human-readable event message."
    },
    "data": {
      "type": "object",
      "description": "Optional event-specific extension data. Keep stable fields promoted to first-class schema properties when they become part of the contract."
    }
  },
  "allOf": [
    { "if": { "properties": { "type": { "enum": ["run.started", "run.updated"] } }, "required": ["type"] }, "then": { "required": ["data"] } },
    { "if": { "properties": { "type": { "const": "run.completed" } }, "required": ["type"] }, "then": { "required": ["artifact"] } },
    { "if": { "properties": { "type": { "const": "run.failed" } }, "required": ["type"] }, "then": { "required": ["failure"] } },
    { "if": { "properties": { "type": { "const": "phase.started" } }, "required": ["type"] }, "then": { "required": ["phase", "agent", "data"] } },
    { "if": { "properties": { "type": { "const": "phase.completed" } }, "required": ["type"] }, "then": { "required": ["phase", "agent", "resultId"] } },
    { "if": { "properties": { "type": { "const": "phase.failed" } }, "required": ["type"] }, "then": { "required": ["phase", "agent", "failure"] } },
    { "if": { "properties": { "type": { "const": "artifact.written" } }, "required": ["type"] }, "then": { "required": ["artifact"] } },
    { "if": { "properties": { "type": { "const": "memory.written" } }, "required": ["type"] }, "then": { "required": ["memoryWrite"] } },
    { "if": { "properties": { "type": { "const": "validation.completed" } }, "required": ["type"] }, "then": { "required": ["validation"] } },
    { "if": { "properties": { "type": { "const": "checkpoint.created" } }, "required": ["type"] }, "then": { "required": ["data"] } },
    { "if": { "properties": { "type": { "enum": ["recovery.started", "recovery.completed"] } }, "required": ["type"] }, "then": { "required": ["capsuleId"] } },
    { "if": { "properties": { "type": { "const": "orchestrator.selected" } }, "required": ["type"] }, "then": { "required": ["selectionId"] } },
    { "if": { "properties": { "type": { "const": "routing.decided" } }, "required": ["type"] }, "then": { "required": ["decisionId"] } },
    { "if": { "properties": { "type": { "const": "preflight.completed" } }, "required": ["type"] }, "then": { "required": ["preflightId"] } },
    { "if": { "properties": { "type": { "enum": ["question.asked", "question.answered"] } }, "required": ["type"] }, "then": { "required": ["questionId"] } },
    { "if": { "properties": { "type": { "const": "task.started" } }, "required": ["type"] }, "then": { "required": ["taskId", "phase", "agent"] } },
    { "if": { "properties": { "type": { "const": "task.completed" } }, "required": ["type"] }, "then": { "required": ["taskId", "resultId"] } },
    { "if": { "properties": { "type": { "const": "task.failed" } }, "required": ["type"] }, "then": { "required": ["taskId", "failure"] } },
    { "if": { "properties": { "type": { "const": "background.started" } }, "required": ["type"] }, "then": { "required": ["taskId", "agent"] } },
    { "if": { "properties": { "type": { "const": "background.completed" } }, "required": ["type"] }, "then": { "required": ["taskId", "resultId"] } },
    { "if": { "properties": { "type": { "const": "background.failed" } }, "required": ["type"] }, "then": { "required": ["taskId", "failure"] } },
    { "if": { "properties": { "type": { "const": "loop.terminated" } }, "required": ["type"] }, "then": { "required": ["loopId", "data"] } },
    { "if": { "properties": { "type": { "enum": ["cancellation.requested", "cancellation.completed"] } }, "required": ["type"] }, "then": { "required": ["cancellationId"] } },
    { "if": { "properties": { "type": { "const": "result.accepted" } }, "required": ["type"] }, "then": { "required": ["resultId"] } },
    { "if": { "properties": { "type": { "const": "capsule.written" } }, "required": ["type"] }, "then": { "required": ["capsuleId", "artifact"] } }
  ],
  "additionalProperties": false,
  "$defs": {
    "failureEvidence": {
      "type": "object",
      "required": ["category", "nextSafeAction"],
      "properties": {
        "category": { "$ref": "common.schema.json#/$defs/identifier" },
        "digest": { "$ref": "common.schema.json#/$defs/identifier" },
        "nextSafeAction": { "type": "string", "minLength": 1 },
        "error": { "$ref": "common.schema.json#/$defs/contractError" }
      },
      "additionalProperties": false
    },
    "artifactRef": {
      "type": "object",
      "required": ["id", "path"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "checksum": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "memoryWriteRef": {
      "type": "object",
      "required": ["id", "backend", "provenance"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "backend": {
          "type": "string",
          "const": "memory"
        },
        "topicKey": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "provenance": { "$ref": "common.schema.json#/$defs/provenance" }
      },
      "additionalProperties": false
    },
    "validationRef": {
      "type": "object",
      "required": ["id", "status"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": ["passed", "failed", "blocked", "skipped"]
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}

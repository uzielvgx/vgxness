[Unit]
Description=Create one verified VGXNESS PostgreSQL backup generation
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=vgxness-syncd-backup
Group=vgxness-syncd-backup
StateDirectory=vgxness-syncd-backup
StateDirectoryMode=0700
Environment=PGSERVICE=vgxness_sync_backup
Environment=PGSERVICEFILE=/etc/vgxness-syncd-backup/pg_service.conf
Environment=PGPASSFILE=/etc/vgxness-syncd-backup/pgpass
UMask=0077
ExecStartPre=-/usr/bin/rm -f -- /var/lib/vgxness-syncd-backup/.current.pgd.tmp
ExecStart=/usr/bin/pg_dump --format=custom --no-owner --no-privileges --file=/var/lib/vgxness-syncd-backup/.current.pgd.tmp
ExecStart=/usr/bin/pg_restore --list /var/lib/vgxness-syncd-backup/.current.pgd.tmp
ExecStart=/usr/bin/sync -f /var/lib/vgxness-syncd-backup/.current.pgd.tmp
ExecStart=/usr/bin/sha256sum /var/lib/vgxness-syncd-backup/.current.pgd.tmp
ExecStart=/usr/bin/mv -T -- /var/lib/vgxness-syncd-backup/.current.pgd.tmp /var/lib/vgxness-syncd-backup/current.pgd
ExecStart=/usr/bin/sync -f /var/lib/vgxness-syncd-backup/current.pgd
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true

# Copy to /etc/vgxness-syncd/syncd.env, replace every placeholder, then set 0600.
# This file is read by systemd; do not put its values in command arguments or logs.
VGXNESS_SYNC_POSTGRES_DSN=postgres://vgxness_syncd:REPLACE_WITH_GENERATED_PASSWORD@127.0.0.1:5432/vgxness_sync?sslmode=disable
VGXNESS_SYNC_OWNER_ID=REPLACE_WITH_CANONICAL_OWNER_UUID
# Optional positive integer admission limits:
# VGXNESS_SYNC_AUTH_GLOBAL_PER_MINUTE=120
# VGXNESS_SYNC_AUTH_DEVICE_PER_MINUTE=60
# VGXNESS_SYNC_AUTH_DEVICE_STATES=256
